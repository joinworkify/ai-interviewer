# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# --- Vapi voice interview generator (see VAPI_SETUP.md) ---------------------

# Vapi Dashboard > Organization/API Keys > PUBLIC key (safe for the browser).
# Never put the Vapi PRIVATE key here.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your-vapi-public-key
# Vapi Dashboard > Assistants > your "Interview Generator" assistant > ID.
NEXT_PUBLIC_VAPI_GENERATOR_ASSISTANT_ID=your-generator-assistant-id

# SERVER-ONLY. Signs short-lived generation capability tokens.
# Generate with: openssl rand -base64 48   (must be >= 32 characters)
VAPI_TOOL_SIGNING_SECRET=replace-with-a-long-random-secret

# SERVER-ONLY. Supabase secret key (sb_secret_...) or legacy service_role key,
# from Project Settings > API Keys. Used only by /api/vapi/generate-interview
# to insert rows into public.interviews. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# SERVER-ONLY. Backend question generation via any OpenAI-compatible
# Chat Completions API. Recommended example below: Google Gemini through its
# OpenAI-compatible endpoint (see "Google Gemini" in VAPI_SETUP.md).
# Key from https://aistudio.google.com/apikey -- never prefix with NEXT_PUBLIC_.
# This is separate from the Vapi assistant's model; configure both.
#
# Generic overrides (any compatible provider works):
#   OpenAI: LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=<openai-model-id>
#   Other:  LLM_BASE_URL=https://<provider>/v1       LLM_MODEL=<model-id>
# If LLM_BASE_URL is unset, the app still defaults to https://api.openai.com/v1
# (unchanged runtime default), so existing OpenAI setups keep working.
LLM_API_KEY=your-google-ai-studio-api-key
# Required: a chat model id your provider supports (no default is assumed).
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Optional, milliseconds (1000-120000). Keep below the Vapi tool timeout.
LLM_TIMEOUT_MS=25000

# --- Gemini Live voice interviewer (see GEMINI_LIVE_SETUP.md) ---------------
# Route: /protected/interview/gemini. Does NOT use Vapi.

# SERVER-ONLY. Google AI Studio API key (https://aistudio.google.com/apikey).
# Used only by /api/gemini-live/token to mint one-use ephemeral tokens; the
# browser never sees it. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=your-google-ai-studio-api-key
# Required: a Live API native-audio model id (not a text model such as
# gemini-2.5-flash). Check the current id in the Live API docs.
GEMINI_LIVE_MODEL=gemini-3.8-live
# Optional, SERVER-ONLY. Public origin the browser uses (scheme://host[:port],
# no path). Set this behind a reverse proxy/CDN where the app server sees an
# internal Host. When unset, the CSRF check uses request scheme + Host header.
# GEMINI_LIVE_APP_ORIGIN=https://your-app.example.com
